# Strava app from https://www.strava.com/settings/api (Authorization Callback Domain: localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Filled in by `uv run auth.py`
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Optional: AI coach comments (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Optional: language of the coach comments, default English
# COACH_LANGUAGE=German
